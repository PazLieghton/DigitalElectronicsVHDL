library IEEE;
use IEEE.STD_LOGIC_1164.ALL;

entity tb_detector_110 is
-- Un testbench no tiene puertos
end tb_detector_110;

architecture Behavioral of tb_detector_110 is
    -- Declaración del componente a probar
    component detector_110
        Port ( clk        : in  STD_LOGIC;
               reset      : in  STD_LOGIC;
               input_bit  : in  STD_LOGIC;
               output_bit : out STD_LOGIC);
    end component;

    -- Señales internas
    signal clk_tb    : STD_LOGIC := '0';
    signal reset_tb  : STD_LOGIC := '1';
    signal input_tb  : STD_LOGIC := '0';
    signal output_tb : STD_LOGIC;

    -- Constante para el período del reloj
    constant clk_period : time := 10 ns;

    -- Secuencia de entrada basada en la Fig 2 (empezando después del reset)
    type bit_array is array (natural range <>) of std_logic;
    constant test_sequence : bit_array := ('0', '0', '1', '1', '0', '0', '0', '1', '1', '0', '1', '0');

begin

    -- Instanciación del DUT (Device Under Test)
    uut: detector_110 port map (
        clk        => clk_tb,
        reset      => reset_tb,
        input_bit  => input_tb,
        output_bit => output_tb
    );

    -- Generación del reloj
    clk_process : process
    begin
        clk_tb <= '0';
        wait for clk_period/2;
        clk_tb <= '1';
        wait for clk_period/2;
    end process;

    -- Proceso de estímulos
    stim_proc: process
    begin
        -- Reset inicial
        reset_tb <= '1';
        wait for clk_period * 2;
        reset_tb <= '0';
        wait for clk_period;

        -- Aplicar la secuencia de bits de la Fig 2
        for i in test_sequence'range loop
            input_tb <= test_sequence(i);
            wait for clk_period;
        end loop;

        -- Esperar un poco antes de terminar la simulación
        wait for clk_period * 2;
        wait; -- Detiene la simulación permanentemente
    end process;

end Behavioral;